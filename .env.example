# Application PostgreSQL
POSTGRES_DB=internship_db
POSTGRES_USER=internship_user
POSTGRES_PASSWORD=change-this-local-db-password
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/internship_db
SPRING_DATASOURCE_USERNAME=internship_user
SPRING_DATASOURCE_PASSWORD=change-this-local-db-password

# Separate Keycloak PostgreSQL database
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-this-keycloak-db-password

# Local Keycloak administrator
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-keycloak-admin-password

# Keycloak issuer and API token audience
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/smart-attachment
KEYCLOAK_API_AUDIENCE=smart-attachment-api

# Mail configuration
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Optional Africa's Talking configuration
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
