# Render-specific Keycloak image.
# The realm JSON is copied into the image so it is available when the
# container starts; no persistent filesystem or bind mount is required.
FROM quay.io/keycloak/keycloak:26.3.3

COPY docker/keycloak/realm/smart-attachment-realm.json /opt/keycloak/data/import/smart-attachment-realm.json

ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start", "--import-realm"]
